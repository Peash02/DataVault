@using System.Security.Claims
@using Microsoft.AspNetCore.Identity
@{
    var username = User.FindFirstValue(ClaimTypes.Name) ?? "";
    var path = Context.Request.Path.Value ?? "/";
    bool IsActive(string p) => path == p || (p != "/" && path.StartsWith(p));
}
<!DOCTYPE html>
<html lang="en" id="htmlRoot">
<head>
    <script>
        // Restore theme before paint to prevent flash
        (function() {
            var t = localStorage.getItem('dvTheme');
            if (t === 'light') document.documentElement.setAttribute('data-theme', 'light');
        })();
    </script>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@(ViewData["Title"] ?? "DataVault") — Secure Personal Vault</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Space+Mono:ital,wght@0,400;0,700;1,400&family=Syne:wght@400;500;600;700;800;900&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/vault.css" asp-append-version="true" />
</head>
<body>
<div class="vault-shell">
    <canvas id="bgCanvas" class="bg-canvas"></canvas>

    @if (!string.IsNullOrEmpty(username))
    {
    <!-- SIDEBAR -->
    <nav class="sidebar">
        <div class="sidebar-brand">
            <div class="brand-hex">
                <svg width="32" height="36" viewBox="0 0 32 36"><polygon points="16,2 30,10 30,26 16,34 2,26 2,10" fill="none" stroke="#00ffc8" stroke-width="1.5"/><polygon points="16,8 24,13 24,23 16,28 8,23 8,13" fill="rgba(0,255,200,0.08)" stroke="#00ffc8" stroke-width="0.8"/></svg>
            </div>
            <div>
                <div class="brand-name">DATAVAULT</div>
                <div class="brand-ver">PROTOCOL v2.0</div>
            </div>
        </div>

        <div class="sidebar-section-label">NAVIGATION</div>
        <div class="sidebar-nav">
            <a href="/" class="nav-item @(IsActive("/") && path=="/" ? "nav-item--active" : "")">
                <span class="nav-icon"><svg width="16" height="16" viewBox="0 0 16 16" fill="none"><rect x="1" y="1" width="6" height="6" rx="1" stroke="currentColor" stroke-width="1.3"/><rect x="9" y="1" width="6" height="6" rx="1" stroke="currentColor" stroke-width="1.3"/><rect x="1" y="9" width="6" height="6" rx="1" stroke="currentColor" stroke-width="1.3"/><rect x="9" y="9" width="6" height="6" rx="1" stroke="currentColor" stroke-width="1.3"/></svg></span>
                <span>Dashboard</span>
            </a>
            <a href="/files" class="nav-item @(IsActive("/files") ? "nav-item--active" : "")">
                <span class="nav-icon"><svg width="16" height="16" viewBox="0 0 16 16" fill="none"><path d="M2 3a1 1 0 011-1h4l2 2h4a1 1 0 011 1v7a1 1 0 01-1 1H3a1 1 0 01-1-1V3z" stroke="currentColor" stroke-width="1.3"/><path d="M5 9l2 2 4-4" stroke="currentColor" stroke-width="1.3" stroke-linecap="round"/></svg></span>
                <span>My Files</span>
            </a>
            <a href="/shares" class="nav-item @(IsActive("/shares") ? "nav-item--active" : "")">
                <span class="nav-icon"><svg width="16" height="16" viewBox="0 0 16 16" fill="none"><circle cx="12" cy="3" r="2" stroke="currentColor" stroke-width="1.3"/><circle cx="4" cy="8" r="2" stroke="currentColor" stroke-width="1.3"/><circle cx="12" cy="13" r="2" stroke="currentColor" stroke-width="1.3"/><path d="M6 7l4-3M6 9l4 3" stroke="currentColor" stroke-width="1.3" stroke-linecap="round"/></svg></span>
                <span>Shares</span>
            </a>
            <a href="/logs" class="nav-item @(IsActive("/logs") ? "nav-item--active" : "")">
                <span class="nav-icon"><svg width="16" height="16" viewBox="0 0 16 16" fill="none"><rect x="2" y="2" width="12" height="12" rx="1.5" stroke="currentColor" stroke-width="1.3"/><path d="M5 6h6M5 8.5h4M5 11h5" stroke="currentColor" stroke-width="1.3" stroke-linecap="round"/></svg></span>
                <span>Access Logs</span>
            </a>
        </div>

        <div class="sidebar-footer">
            <div class="user-info">
                <div class="user-avatar">@(username.Length > 0 ? username[0].ToString().ToUpper() : "U")</div>
                <div class="user-details">
                    <div class="user-name">@username</div>
                    <div class="user-status">● CONNECTED</div>
                </div>
            </div>
            <form method="post" action="/logout">
                @Html.AntiForgeryToken()
                <button type="submit" class="btn-logout" title="Disconnect">
                    <svg width="16" height="16" viewBox="0 0 16 16" fill="none"><path d="M10 8H3M6 5l-3 3 3 3" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/><path d="M8 3h4a1 1 0 011 1v8a1 1 0 01-1 1H8" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"/></svg>
                </button>
            </form>
        </div>
    </nav>
    }

    <!-- MAIN CONTENT -->
    <main class="main-content @(string.IsNullOrEmpty(username) ? "main-content--full" : "")">
        @if (!string.IsNullOrEmpty(username))
        {
        <div class="topbar">
            <div class="topbar-path">
                <span class="topbar-slash">//</span>
                <span class="topbar-section">@(ViewData["Title"] ?? "Dashboard")</span>
            </div>
            <div class="topbar-meta">
                <span class="topbar-time" id="liveClock"></span>
                <span class="topbar-badge">AES-256</span>
                <span class="topbar-badge topbar-badge--green">● SECURE</span>
                <button class="theme-toggle" id="themeToggle" title="Toggle light / dark theme" onclick="toggleTheme()">
                    <svg width="13" height="13" viewBox="0 0 16 16" fill="none" id="themeIcon">
                        <circle cx="8" cy="8" r="3.5" stroke="currentColor" stroke-width="1.4"/>
                        <path d="M8 1v2M8 13v2M1 8h2M13 8h2M3.05 3.05l1.42 1.42M11.53 11.53l1.42 1.42M3.05 12.95l1.42-1.42M11.53 4.47l1.42-1.42" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"/>
                    </svg>
                    <span id="themeLabel">LIGHT</span>
                </button>
            </div>
        </div>
        }

        @if (TempData["Success"] != null)
        {
            <div class="alert alert--success">
                <svg width="16" height="16" viewBox="0 0 16 16" fill="none"><circle cx="8" cy="8" r="6" stroke="currentColor" stroke-width="1.3"/><path d="M5 8l2 2 4-4" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round"/></svg>
                @TempData["Success"]
            </div>
        }
        @if (TempData["Error"] != null)
        {
            <div class="alert alert--error">
                <svg width="16" height="16" viewBox="0 0 16 16" fill="none"><circle cx="8" cy="8" r="6" stroke="currentColor" stroke-width="1.3"/><path d="M8 5v3M8 10.5v.5" stroke="currentColor" stroke-width="1.3" stroke-linecap="round"/></svg>
                @TempData["Error"]
            </div>
        }
        @if (TempData["ShareUrl"] != null)
        {
            <div class="alert alert--info" id="shareUrlAlert">
                <div>
                    <strong>Share link created:</strong>
                    <span id="shareUrlText" style="font-family:'Space Mono',monospace;font-size:12px;margin:0 10px;color:#00ffc8">@TempData["ShareUrl"]</span>
                </div>
                <button onclick="copyShareUrl()" class="btn-copy-inline">COPY</button>
            </div>
        }

        <div class="page-body">
            @RenderBody()
        </div>
    </main>
</div>

<script src="~/js/vault.js" asp-append-version="true"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
