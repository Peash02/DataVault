@model FileDetailViewModel
@{ ViewData["Title"] = "File Detail"; var f = Model.File!; }

<div class="page-header">
    <div>
        <div class="eyebrow">// FILE_DETAIL</div>
        <h1 class="page-title">@(f.OriginalFileName.Length > 40 ? f.OriginalFileName[..37]+"…" : f.OriginalFileName)</h1>
    </div>
    <a href="/files" class="btn-secondary">← BACK</a>
</div>

<!-- File Info Card -->
<div class="detail-grid">
    <div class="card">
        <div class="card-head"><span class="card-eyebrow">// FILE_METADATA</span></div>
        <div class="meta-panel">
            <div class="meta-row"><span>FILE NAME</span><span class="meta-val">@f.OriginalFileName</span></div>
            <div class="meta-row"><span>CONTENT TYPE</span><span class="meta-val">@f.ContentType</span></div>
            <div class="meta-row"><span>SIZE</span><span class="meta-val">@FormatBytes(f.FileSizeBytes)</span></div>
            <div class="meta-row"><span>CURRENT VERSION</span><span class="meta-val text-accent">v@f.CurrentVersion</span></div>
            <div class="meta-row"><span>UPLOADED</span><span class="meta-val">@f.UploadedAt.ToString("yyyy-MM-dd HH:mm") UTC</span></div>
            @if (f.LastModifiedAt.HasValue)
            {
                <div class="meta-row"><span>LAST MODIFIED</span><span class="meta-val">@f.LastModifiedAt.Value.ToString("yyyy-MM-dd HH:mm") UTC</span></div>
            }
            <div class="meta-row"><span>SHA-256 HASH</span><span class="meta-val meta-hash">@f.FileHash</span></div>
            <div class="meta-row"><span>SHARES</span><span class="meta-val">@f.ShareCount active</span></div>
            <div class="meta-row"><span>TOTAL VIEWS</span><span class="meta-val">@f.ViewCount</span></div>
        </div>
        <div class="card-pad">
            <a href="/files/@f.Id/download" class="btn-primary" style="margin-right:8px">↓ DECRYPT &amp; DOWNLOAD</a>
            <form method="post" action="/files/@f.Id/delete" style="display:inline"
                  onsubmit="return confirm('Permanently delete this file?')">
                @Html.AntiForgeryToken()
                <button type="submit" class="btn-danger">DELETE FILE</button>
            </form>
        </div>
    </div>

    <!-- Version History -->
    <div class="card">
        <div class="card-head"><span class="card-eyebrow">// VERSION_HISTORY</span></div>
        @if (!Model.Versions.Any())
        {
            <div class="card-empty">No previous versions — this is v1.</div>
        }
        else
        {
            <div class="versions-list">
                @foreach (var v in Model.Versions)
                {
                    <div class="version-item">
                        <div class="version-badge">v@v.VersionNumber</div>
                        <div class="version-body">
                            <div class="version-date">@v.CreatedAt.ToString("yyyy-MM-dd HH:mm")</div>
                            <div class="version-hash">@v.FileHash[..20]…</div>
                            @if (!string.IsNullOrEmpty(v.ChangeNote))
                            {
                                <div class="version-note">"@v.ChangeNote"</div>
                            }
                        </div>
                        <div class="version-size">@FormatBytes(v.FileSizeBytes)</div>
                        <form method="post" action="/files/@f.Id/versions/@v.Id/restore"
                              onsubmit="return confirm('Restore to this version?')">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn-sm btn-sm--ghost">RESTORE</button>
                        </form>
                    </div>
                }
            </div>
        }
    </div>
</div>

<!-- Access Log for this file -->
<div class="card" style="margin-top:16px">
    <div class="card-head">
        <span class="card-eyebrow">// FILE_ACCESS_LOG</span>
        <span class="card-count">@Model.Logs.Count events</span>
    </div>
    @if (!Model.Logs.Any())
    {
        <div class="card-empty">No access events for this file yet.</div>
    }
    else
    {
        <div class="table-wrap">
            <table class="vtable">
                <thead><tr><th>TIMESTAMP</th><th>ACTION</th><th>ACTOR</th><th>IP</th><th>STATUS</th><th>DETAILS</th></tr></thead>
                <tbody>
                @foreach (var l in Model.Logs)
                {
                    <tr class="@(!l.WasGranted ? "tr--denied" : "")">
                        <td class="td-mono">@l.Timestamp.ToString("yyyy-MM-dd HH:mm:ss")</td>
                        <td><span class="action-badge @GetActionBadge(l.Action)">@l.Action.Replace("_"," ")</span></td>
                        <td class="td-muted">@l.ActorIdentifier</td>
                        <td class="td-mono td-muted">@(l.IpAddress ?? "—")</td>
                        <td>@if(l.WasGranted){<span class="status-ok">✓</span>}else{<span class="status-no">✕</span>}</td>
                        <td class="td-muted">@(l.Details ?? "—")</td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    }
</div>

@functions {
    string FormatBytes(long b) {
        if (b < 1024) return $"{b} B";
        if (b < 1024*1024) return $"{b/1024.0:F1} KB";
        return $"{b/1024.0/1024.0:F1} MB";
    }
    string GetActionBadge(string a) => a.ToLower() switch {
        var x when x.Contains("denied") => "badge-red",
        var x when x.Contains("download") => "badge-blue",
        var x when x.Contains("upload") => "badge-green",
        var x when x.Contains("share") => "badge-purple",
        _ => "badge-cyan"
    };
}
